              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Restaurant\",\n  \"nameAr\": \"مطعم محدث\",\n  \"address\": \"456 Updated St, Aswan\",\n  \"phone\": \"+20123456789\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/restaurants/:id",
              "host": ["{{baseUrl}}"],
