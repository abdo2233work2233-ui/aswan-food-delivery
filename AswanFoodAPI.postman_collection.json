              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/restaurants/:id",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "restaurants", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "restaurant-id"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Admin - Analytics",
      "item": [
        {
          "name": "Get Analytics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/analytics",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "analytics"]
            }
          }
        }
      ]
    },
    {
      "name": "Health Check",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/../health",
              "host": ["{{baseUrl}}"],
              "path": ["..", "health"]
            }
          }
        }
      ]
    }
  ]
}

